SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=43200
INVITE_CODE=huiming

POSTGRES_USER=wensai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wensai

INTERNAL_API_TOKEN=change-me-use-openssl-rand-hex-32
CORS_ORIGINS=https://your-domain.example.com

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=1024
TIMEZONE=Asia/Shanghai

# Path to a checkout of https://github.com/huiming-git/WenSai-AgentSDK
# Relative paths are resolved from deploy/production when using the compose file there.
AGENTSDK_BUILD_CONTEXT=../../../WenSai-AgentSDK

# Production target: official CubeSandbox runs on the host/bare-metal node.
SANDBOX_BACKEND=cube
CUBE_API_URL=http://host.docker.internal:3000
CUBE_API_KEY=dummy
CUBE_TEMPLATE_ID=

# Local fallback only. Do not call it CubeSandbox.
LOCAL_SANDBOX_DIRNAME=local-sandbox
LOCAL_SANDBOX_ENFORCE_PROCESS=true
BWRAP_COMMAND=bwrap

DEFAULT_RUNTIME=hermes-acp
HERMES_ACP_COMMAND=hermes
HERMES_ACP_ARGS=acp
HERMES_ACP_TIMEOUT_SECONDS=900
APPROVAL_POLL_SECONDS=2
APPROVAL_TIMEOUT_SECONDS=3600
