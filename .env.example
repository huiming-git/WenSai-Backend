# ==== 应用 ====
# 生产必须替换：openssl rand -hex 32
SECRET_KEY=change-me-to-a-strong-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 注册邀请码
INVITE_CODE=huiming

# ==== 数据库 ====
# Docker Compose / worker / api 推荐统一使用这一条连接串
DATABASE_URL=postgresql+psycopg2://wensai:change-me@db:5432/wensai
# 同时保留 POSTGRES_*，供 docker-compose 初始化 PostgreSQL 使用
POSTGRES_USER=wensai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wensai
REDIS_URL=redis://redis:6379/0
# 本地开发可改为 redis://localhost:6379/0

# ==== 上传 ====
UPLOAD_DIR=/app/uploads
# Max upload size in MB
MAX_UPLOAD_SIZE_MB=1024
TIMEZONE=Asia/Shanghai

# ==== LLM（OpenAI 兼容）====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ==== 存储后端：local 或 s3 ====
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ==== CORS（逗号分隔，精确到前端域名）====
# 正式环境请改成你的前端域名，不要保留 localhost / 127.0.0.1
CORS_ORIGINS=https://your-frontend.example.com

# ==== AgentSDK internal service ====
AGENTSDK_BASE_URL=http://agentsdk:8010
INTERNAL_API_TOKEN=change-me-to-a-strong-random-service-token
DISPATCH_AGENT_TASKS=true
