# ==== 应用 ====
# 生产必须替换：openssl rand -hex 32
SECRET_KEY=change-me-to-a-strong-random-value

# 注册邀请码
INVITE_CODE=huiming

# ==== 数据库 ====
# Docker Compose 会用 POSTGRES_* 组合出 DATABASE_URL；单独跑应用时可直接指定 DATABASE_URL
POSTGRES_USER=wensai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wensai
# DATABASE_URL=sqlite:///./wensai.db
# DATABASE_URL=postgresql+psycopg2://wensai:change-me@db:5432/wensai

# ==== 上传 ====
UPLOAD_DIR=/app/uploads

# ==== LLM（OpenAI 兼容）====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ==== 存储后端：local 或 s3 ====
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ==== CORS（逗号分隔，精确到前端域名）====
CORS_ORIGINS=http://localhost:1420,http://localhost:5173
